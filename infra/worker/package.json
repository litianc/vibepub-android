{
  "name": "vibepub-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:remote": "wrangler d1 migrations apply vibepub-db --remote",
    "backfill:recordings": "node scripts/backfill-recording-metadata.mjs",
    "test": "node --test test/*.test.mjs",
    "test:runtime": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.19",
    "@cloudflare/workers-types": "^4.20260624.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.104.0"
  },
  "dependencies": {
    "agents": "^0.17.4"
  }
}
